{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ai": {
    "Groq": {
      "BaseUrl": "https://api.groq.com/openai/v1/",
      "Model": "openai/gpt-oss-120b",
      "ReasoningEffort": "low",
      "MaxCompletionTokens": 1800,
      "TimeoutSeconds": 20
    },
    "KeywordGap": {
      "MaxJobDescriptionChars": 6000,
      "MaxCvChars": 7000,
      "MaxBodyBytes": 65536,
      "WindowMinutes": 10,
      "PerUserPermits": 4,
      "GlobalPermits": 8
    }
  },
  "AllowedHosts": "*",
  "PublicOrigin": "https://job-tracker-tosh9.vercel.app"
}
