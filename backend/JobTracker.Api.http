# Requests for the API running locally (dotnet run, port 5073).
#
# Every route except /health/db needs a signed-in session:
#   1. Sign in through the app at http://localhost:3000 (GitHub or Google).
#   2. In the browser's DevTools, Application tab, Cookies, copy the value of the "session" cookie.
#   3. Paste it over the placeholder below while you test. Never commit a real value.
#
# Another user's rows answer 404, not 403. /admin/stats answers 403 to non-admins.
# Enums are sent as strings. DateApplied is a plain date. ScheduledAt is a date and time with an offset.

@JobTracker.Api_HostAddress = http://localhost:5073
@session = <paste-session-cookie>

### Who am I (401 when the cookie is missing or expired)
GET {{JobTracker.Api_HostAddress}}/auth/me
Cookie: session={{session}}

### Sign out
POST {{JobTracker.Api_HostAddress}}/auth/logout
Cookie: session={{session}}

### List your applications
GET {{JobTracker.Api_HostAddress}}/job-applications/
Cookie: session={{session}}
Accept: application/json

### List your applications filtered by status
GET {{JobTracker.Api_HostAddress}}/job-applications/?status=Interviewing
Cookie: session={{session}}
Accept: application/json

### Get one application (use an id from the list)
GET {{JobTracker.Api_HostAddress}}/job-applications/1
Cookie: session={{session}}
Accept: application/json

### Create an application
POST {{JobTracker.Api_HostAddress}}/job-applications/
Cookie: session={{session}}
Content-Type: application/json

{
  "company": "Acme Corp",
  "roleTitle": "Backend Engineer",
  "status": "Applied",
  "dateApplied": "2026-09-20",
  "notes": "Referred by a friend"
}

### Create an application with an empty Company (expect 400)
POST {{JobTracker.Api_HostAddress}}/job-applications/
Cookie: session={{session}}
Content-Type: application/json

{
  "company": "",
  "roleTitle": "Backend Engineer",
  "status": "Applied",
  "dateApplied": "2026-09-20",
  "notes": null
}

### Update an application
PUT {{JobTracker.Api_HostAddress}}/job-applications/1
Cookie: session={{session}}
Content-Type: application/json

{
  "company": "Acme Corp",
  "roleTitle": "Senior Backend Engineer",
  "status": "Interviewing",
  "dateApplied": "2026-09-20",
  "notes": "Moved to interviewing"
}

### Delete an application (its stages and documents go with it)
DELETE {{JobTracker.Api_HostAddress}}/job-applications/1
Cookie: session={{session}}

### Create an interview stage under application 1
POST {{JobTracker.Api_HostAddress}}/job-applications/1/interview-stages/
Cookie: session={{session}}
Content-Type: application/json

{
  "stageName": "Phone Screen",
  "scheduledAt": "2026-09-22T15:00:00Z",
  "outcome": "Pending",
  "notes": null
}

### Update interview stage 1 under application 1
PUT {{JobTracker.Api_HostAddress}}/job-applications/1/interview-stages/1
Cookie: session={{session}}
Content-Type: application/json

{
  "stageName": "Phone Screen",
  "scheduledAt": "2026-09-22T15:00:00Z",
  "outcome": "Passed",
  "notes": "Went well"
}

### Delete interview stage 1 under application 1
DELETE {{JobTracker.Api_HostAddress}}/job-applications/1/interview-stages/1
Cookie: session={{session}}

### Mismatched parent: stage 1 does not belong to application 2 (expect 404)
PUT {{JobTracker.Api_HostAddress}}/job-applications/2/interview-stages/1
Cookie: session={{session}}
Content-Type: application/json

{
  "stageName": "Should not apply",
  "scheduledAt": null,
  "outcome": "Failed",
  "notes": null
}

### Create a document under application 1
POST {{JobTracker.Api_HostAddress}}/job-applications/1/documents/
Cookie: session={{session}}
Content-Type: application/json

{
  "type": "Cv",
  "label": "Resume v3",
  "notes": null
}

### Update document 1 under application 1
PUT {{JobTracker.Api_HostAddress}}/job-applications/1/documents/1
Cookie: session={{session}}
Content-Type: application/json

{
  "type": "CoverLetter",
  "label": "Resume v4",
  "notes": "Updated"
}

### Delete document 1 under application 1
DELETE {{JobTracker.Api_HostAddress}}/job-applications/1/documents/1
Cookie: session={{session}}

### Admin counts (403 unless your user id is in Authorization:AdminUserIds)
GET {{JobTracker.Api_HostAddress}}/admin/stats
Cookie: session={{session}}

### Keyword gap with invented texts only. Each send spends one of your 4 permits per 10 minutes and one Groq call.
POST {{JobTracker.Api_HostAddress}}/ai/keyword-gap
Cookie: session={{session}}
Content-Type: application/json

{
  "jobDescription": "Seeking a .NET developer with REST API, SQL and Docker experience.",
  "cvText": "Built REST APIs in C# and .NET with SQL Server."
}

### Database health (anonymous for now, no cookie needed)
GET {{JobTracker.Api_HostAddress}}/health/db
